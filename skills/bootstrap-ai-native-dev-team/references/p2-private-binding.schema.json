{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bzbaizhen/ai-native-dev-team-skill/p2-private-binding.schema.json",
  "title": "P2 private binding",
  "description": "Local-only binding for one externally witnessed release-audit event. The ai-native-cj-1 profile is deliberately narrower than RFC 8785.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "window_id",
    "sequence",
    "record_kind",
    "private_anchor_commit",
    "private_object_sha256",
    "candidate_commit",
    "previous_private_binding_sha256",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "window_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "record_kind": {
      "type": "string",
      "enum": ["window_freeze", "task_ready", "task_outcome", "window_closure"]
    },
    "private_anchor_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "private_object_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "previous_private_binding_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    }
  }
}
