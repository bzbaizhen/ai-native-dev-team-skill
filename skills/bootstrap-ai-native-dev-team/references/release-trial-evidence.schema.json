{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bzbaizhen/ai-native-dev-team-skill/release-trial-evidence.schema.json",
  "title": "V2 release trial request or acceptance evidence",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/acceptance"}
  ],
  "$defs": {
    "tree_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["history_sensitive", "non_tree_dependencies"],
      "properties": {
        "history_sensitive": {"const": false},
        "non_tree_dependencies": {
          "type": "array",
          "maxItems": 0,
          "items": {"type": "string"}
        }
      }
    },
    "integration_proof": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {"mode": {"const": "same_commit"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "candidate_ref",
            "candidate_tree",
            "stable_tree",
            "tree_scope"
          ],
          "properties": {
            "mode": {"const": "same_tree"},
            "candidate_ref": {
              "type": "string",
              "pattern": "^refs/(heads|tags)/.+$"
            },
            "candidate_tree": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{40}$"
            },
            "stable_tree": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{40}$"
            },
            "tree_scope": {"$ref": "#/$defs/tree_scope"}
          }
        }
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "evidence_type",
        "project_evidence_id",
        "task_id",
        "occurred_at",
        "genuine_request",
        "synthetic",
        "summary"
      ],
      "properties": {
        "schema_version": {"const": "2.0"},
        "evidence_type": {"const": "task_request"},
        "project_evidence_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "occurred_at": {"type": "string", "format": "date-time"},
        "genuine_request": {"const": true},
        "synthetic": {"const": false},
        "summary": {"type": "string", "minLength": 1},
        "source_locator": {"type": "string", "minLength": 1}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "evidence_type",
        "project_evidence_id",
        "task_id",
        "occurred_at",
        "accepted",
        "accepted_by_role",
        "candidate_commit",
        "stable_commit",
        "integration_proof",
        "critical_defect_escape",
        "material_quality_regression",
        "scope_violation",
        "write_conflict",
        "recovery_executable"
      ],
      "properties": {
        "schema_version": {"const": "2.0"},
        "evidence_type": {"const": "task_acceptance"},
        "project_evidence_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "occurred_at": {"type": "string", "format": "date-time"},
        "accepted": {"const": true},
        "accepted_by_role": {"type": "string", "minLength": 1},
        "candidate_commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "stable_commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "integration_proof": {"$ref": "#/$defs/integration_proof"},
        "critical_defect_escape": {"type": "boolean"},
        "material_quality_regression": {"type": "boolean"},
        "scope_violation": {"type": "boolean"},
        "write_conflict": {"type": "boolean"},
        "recovery_executable": {"type": "boolean"},
        "source_locator": {"type": "string", "minLength": 1}
      }
    }
  }
}
