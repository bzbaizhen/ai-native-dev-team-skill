{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bzbaizhen/ai-native-dev-team-skill/release-trial-evidence.schema.json",
  "title": "V2 release trial request or acceptance evidence",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/acceptance"}
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "evidence_type",
        "project_evidence_id",
        "task_id",
        "occurred_at",
        "genuine_request",
        "synthetic",
        "summary"
      ],
      "properties": {
        "schema_version": {"const": "2.0"},
        "evidence_type": {"const": "task_request"},
        "project_evidence_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "occurred_at": {"type": "string", "format": "date-time"},
        "genuine_request": {"const": true},
        "synthetic": {"const": false},
        "summary": {"type": "string", "minLength": 1},
        "source_locator": {"type": "string", "minLength": 1}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "evidence_type",
        "project_evidence_id",
        "task_id",
        "occurred_at",
        "accepted",
        "accepted_by_role",
        "candidate_commit",
        "stable_commit",
        "critical_defect_escape",
        "material_quality_regression",
        "scope_violation",
        "write_conflict",
        "recovery_executable"
      ],
      "properties": {
        "schema_version": {"const": "2.0"},
        "evidence_type": {"const": "task_acceptance"},
        "project_evidence_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "occurred_at": {"type": "string", "format": "date-time"},
        "accepted": {"const": true},
        "accepted_by_role": {"type": "string", "minLength": 1},
        "candidate_commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "stable_commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "critical_defect_escape": {"type": "boolean"},
        "material_quality_regression": {"type": "boolean"},
        "scope_violation": {"type": "boolean"},
        "write_conflict": {"type": "boolean"},
        "recovery_executable": {"type": "boolean"},
        "source_locator": {"type": "string", "minLength": 1}
      }
    }
  }
}
