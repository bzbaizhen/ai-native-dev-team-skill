{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bzbaizhen/ai-native-dev-team-skill/release-v1-baseline-evidence.schema.json",
  "title": "Frozen V1 baseline evidence for a V2 release stratum",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "baseline_id",
    "baseline_version",
    "measurement_type",
    "stratum_id",
    "evidence_scope",
    "efficiency_denominators_available",
    "source_evidence",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "baseline_id": {"type": "string", "minLength": 1},
    "baseline_version": {"const": "v1.0.0"},
    "measurement_type": {"const": "historical_reconstruction"},
    "stratum_id": {
      "type": "string",
      "pattern": "^C[0-3]\\|R[0-3]\\|(no-delegation|single-worker|task-cell|team-required)$"
    },
    "evidence_scope": {"enum": ["case-level", "task-level"]},
    "efficiency_denominators_available": {"type": "boolean"},
    "source_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "evidence_kind",
          "source_revision",
          "evidence_path",
          "evidence_sha256",
          "supports"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "evidence_kind": {
            "enum": [
              "task_contract",
              "qa_report",
              "acceptance_record",
              "git_record",
              "metrics_record"
            ]
          },
          "source_revision": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{40}$"
          },
          "evidence_path": {"type": "string", "minLength": 1},
          "evidence_sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "supports": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "task_identity",
                "stratum",
                "acceptance",
                "efficiency_denominator"
              ]
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "supports": {"contains": {"const": "stratum"}}
              },
              "required": ["supports"]
            },
            "then": {
              "properties": {
                "evidence_kind": {"const": "task_contract"}
              }
            }
          },
          {
            "if": {
              "properties": {
                "supports": {"contains": {"const": "acceptance"}}
              },
              "required": ["supports"]
            },
            "then": {
              "properties": {
                "evidence_kind": {
                  "enum": ["qa_report", "acceptance_record", "git_record"]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "supports": {"contains": {"const": "efficiency_denominator"}}
              },
              "required": ["supports"]
            },
            "then": {
              "properties": {
                "evidence_kind": {"const": "metrics_record"}
              }
            }
          }
        ]
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "properties": {
        "source_evidence": {
          "contains": {
            "properties": {
              "supports": {"contains": {"const": "task_identity"}}
            },
            "required": ["supports"]
          }
        }
      }
    },
    {
      "properties": {
        "source_evidence": {
          "contains": {
            "properties": {
              "supports": {"contains": {"const": "stratum"}}
            },
            "required": ["supports"]
          }
        }
      }
    },
    {
      "properties": {
        "source_evidence": {
          "contains": {
            "properties": {
              "supports": {"contains": {"const": "acceptance"}}
            },
            "required": ["supports"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "efficiency_denominators_available": {"const": true}
        },
        "required": ["efficiency_denominators_available"]
      },
      "then": {
        "properties": {
          "evidence_scope": {"const": "task-level"},
          "source_evidence": {
            "contains": {
              "properties": {
                "evidence_kind": {"const": "metrics_record"},
                "supports": {"contains": {"const": "efficiency_denominator"}}
              },
              "required": ["evidence_kind", "supports"]
            }
          }
        }
      }
    }
  ]
}
