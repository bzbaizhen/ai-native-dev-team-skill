{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bzbaizhen/ai-native-dev-team-skill/release-anchor-closure.schema.json",
  "title": "Closed V2 registration anchor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "closure_type",
    "candidate_commit",
    "anchor_freeze_commit",
    "final_registration_commit",
    "closed_at",
    "registration_count",
    "trial_manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "closure_type": {"const": "registration_window_closed"},
    "candidate_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "anchor_freeze_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "final_registration_commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "closed_at": {"type": "string", "format": "date-time"},
    "registration_count": {"type": "integer", "minimum": 0},
    "trial_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    }
  }
}
