{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bzbaizhen/ai-native-dev-team-skill/metrics-event.schema.json",
  "title": "AI-native team metrics event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "timestamp", "task_id", "event"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "timestamp": {"type": "string", "format": "date-time"},
    "task_id": {"type": "string", "minLength": 1},
    "event": {
      "enum": [
        "task_ready",
        "worker_started",
        "dev_complete",
        "qa_complete",
        "accepted",
        "blocked",
        "reopened",
        "cancelled"
      ]
    },
    "actor": {"type": "string", "minLength": 1},
    "complexity": {"enum": ["C0", "C1", "C2", "C3"]},
    "risk": {"enum": ["R0", "R1", "R2", "R3"]},
    "topology": {"enum": ["no-delegation", "single-worker", "task-cell", "team-required"]},
    "governance_profile": {"enum": ["lean", "controlled", "strict"]},
    "material_behavior_change": {"type": "boolean"},
    "release_trial_registration_sequence": {"type": "integer", "minimum": 1},
    "skill_candidate_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "release_trial_comparable": {"type": "boolean"},
    "v1_baseline_id": {"type": ["string", "null"], "minLength": 1},
    "v1_baseline_stratum": {"type": ["string", "null"], "minLength": 1},
    "capability_tier": {"enum": ["economy", "standard", "advanced", "frontier", "main-agent"]},
    "reasoning_tier": {"enum": ["low", "medium", "high", "max", "current"]},
    "actual_model": {"type": "string", "minLength": 1},
    "escalation_reason": {"type": "string", "minLength": 1},
    "approved_writer": {"type": "boolean"},
    "team_skill_loaded": {"type": "boolean"},
    "owned_paths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "backlog_override_reason": {"type": "string", "minLength": 1},
    "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "stable_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "result": {"enum": ["PASSED", "FAILED", "BLOCKED"]},
    "independent_validation": {"type": "boolean"},
    "status_truth_match": {"type": "boolean"},
    "rollback_executable": {"type": "boolean"},
    "owner_approval": {"type": "boolean"},
    "reason": {"type": "string", "minLength": 1},
    "active_minutes": {"type": "number", "minimum": 0},
    "governance_minutes": {"type": "number", "minimum": 0},
    "metadata": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"event": {"const": "task_ready"}}},
      "then": {
        "required": [
          "complexity",
          "risk",
          "topology",
          "governance_profile",
          "material_behavior_change"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event": {"const": "task_ready"},
          "release_trial_comparable": {"const": true}
        },
        "required": ["event", "release_trial_comparable"]
      },
      "then": {
        "required": [
          "release_trial_registration_sequence",
          "skill_candidate_commit",
          "v1_baseline_id",
          "v1_baseline_stratum"
        ],
        "properties": {
          "v1_baseline_id": {"type": "string", "minLength": 1},
          "v1_baseline_stratum": {
            "type": "string",
            "pattern": "^C[0-3]\\|R[0-3]\\|(no-delegation|single-worker|task-cell|team-required)$"
          }
        }
      }
    },
    {
      "if": {"properties": {"event": {"const": "worker_started"}}},
      "then": {
        "required": [
          "actor",
          "capability_tier",
          "reasoning_tier",
          "approved_writer",
          "team_skill_loaded",
          "owned_paths"
        ]
      }
    },
    {
      "if": {"properties": {"event": {"const": "dev_complete"}}},
      "then": {"required": ["actor", "commit"]}
    },
    {
      "if": {"properties": {"event": {"const": "qa_complete"}}},
      "then": {"required": ["commit", "result", "independent_validation"]}
    },
    {
      "if": {"properties": {"event": {"const": "accepted"}}},
      "then": {
        "required": [
          "commit",
          "stable_commit",
          "status_truth_match",
          "rollback_executable",
          "owner_approval"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event": {"enum": ["blocked", "reopened", "cancelled"]}
        }
      },
      "then": {"required": ["reason"]}
    }
  ]
}
