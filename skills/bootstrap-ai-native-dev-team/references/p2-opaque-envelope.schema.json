{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bzbaizhen/ai-native-dev-team-skill/p2-opaque-envelope.schema.json",
  "title": "P2 public opaque envelope",
  "description": "Public allowlist containing no private task, project, path or Git identity fields.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_type", "opaque_window_id", "sequence", "commitment_sha256", "previous_envelope_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "receipt_type": {"const": "opaque_release_audit_commitment"},
    "opaque_window_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "commitment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "previous_envelope_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
  }
}
