{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bzbaizhen/ai-native-dev-team-skill/release-trial-manifest.schema.json",
  "title": "V2 release trial manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_version",
    "candidate_commit",
    "candidate_frozen_at",
    "registry_closed_at",
    "source_registry",
    "source_registry_sha256",
    "required_comparable_tasks",
    "sources",
    "trials"
  ],
  "$defs": {
    "tree_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["history_sensitive", "non_tree_dependencies"],
      "properties": {
        "history_sensitive": {"const": false},
        "non_tree_dependencies": {
          "type": "array",
          "maxItems": 0,
          "items": {"type": "string"}
        }
      }
    },
    "integration_proof": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {"mode": {"const": "same_commit"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "candidate_ref",
            "candidate_tree",
            "stable_tree",
            "tree_scope"
          ],
          "properties": {
            "mode": {"const": "same_tree"},
            "candidate_ref": {
              "type": "string",
              "pattern": "^refs/(heads|tags)/.+$"
            },
            "candidate_tree": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{40}$"
            },
            "stable_tree": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{40}$"
            },
            "tree_scope": {"$ref": "#/$defs/tree_scope"}
          }
        }
      ]
    }
  },
  "properties": {
    "schema_version": {"const": "2.0"},
    "candidate_version": {"type": "string", "minLength": 1},
    "candidate_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "candidate_frozen_at": {"type": "string", "format": "date-time"},
    "registry_closed_at": {"type": "string", "format": "date-time"},
    "source_registry": {"type": "string", "minLength": 1},
    "source_registry_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "required_comparable_tasks": {"type": "integer", "minimum": 5},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "project_alias",
          "project_evidence_id",
          "project_repo",
          "stable_branch",
          "ledger",
          "ledger_prefix_bytes",
          "ledger_prefix_sha256",
          "ledger_sha256"
        ],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "project_alias": {"type": "string", "minLength": 1},
          "project_evidence_id": {"type": "string", "minLength": 1},
          "project_repo": {"type": "string", "minLength": 1},
          "stable_branch": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
          },
          "ledger": {"type": "string", "minLength": 1},
          "ledger_prefix_bytes": {"type": "integer", "minimum": 0},
          "ledger_prefix_sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "ledger_sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        }
      }
    },
    "trials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trial_id",
          "registration_sequence",
          "source_id",
          "task_id",
          "skill_candidate_commit",
          "request_evidence",
          "request_evidence_sha256",
          "v1_baseline_id",
          "v1_baseline_stratum",
          "comparable",
          "disposition",
          "genuine_request",
          "synthetic",
          "critical_defect_escape",
          "material_quality_regression",
          "scope_violation",
          "write_conflict",
          "recovery_executable"
        ],
        "properties": {
          "trial_id": {"type": "string", "minLength": 1},
          "registration_sequence": {"type": "integer", "minimum": 1},
          "source_id": {"type": "string", "minLength": 1},
          "task_id": {"type": "string", "minLength": 1},
          "skill_candidate_commit": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{40}$"
          },
          "candidate_commit": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{40}$"
          },
          "stable_commit": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{40}$"
          },
          "integration_proof": {"$ref": "#/$defs/integration_proof"},
          "request_evidence": {"type": "string", "minLength": 1},
          "request_evidence_sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "acceptance_evidence": {"type": "string", "minLength": 1},
          "acceptance_evidence_sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "v1_baseline_id": {"type": ["string", "null"], "minLength": 1},
          "v1_baseline_stratum": {"type": ["string", "null"], "minLength": 1},
          "comparable": {"type": "boolean"},
          "disposition": {
            "enum": ["accepted", "in_progress", "blocked", "cancelled", "rejected"]
          },
          "genuine_request": {"type": "boolean"},
          "synthetic": {"type": "boolean"},
          "exclusion_reason": {"type": "string", "minLength": 1},
          "critical_defect_escape": {"type": "boolean"},
          "material_quality_regression": {"type": "boolean"},
          "scope_violation": {"type": "boolean"},
          "write_conflict": {"type": "boolean"},
          "recovery_executable": {"type": "boolean"},
          "notes": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {"comparable": {"const": false}},
              "required": ["comparable"]
            },
            "then": {"required": ["exclusion_reason"]}
          },
          {
            "if": {
              "properties": {"comparable": {"const": true}},
              "required": ["comparable"]
            },
            "then": {
              "properties": {
                "v1_baseline_id": {"type": "string", "minLength": 1},
                "v1_baseline_stratum": {
                  "type": "string",
                  "pattern": "^C[0-3]\\|R[0-3]\\|(no-delegation|single-worker|task-cell|team-required)$"
                }
              }
            },
            "else": {
              "properties": {
                "v1_baseline_id": {"type": "null"},
                "v1_baseline_stratum": {"type": "null"}
              }
            }
          },
          {
            "if": {
              "properties": {"disposition": {"const": "accepted"}},
              "required": ["disposition"]
            },
            "then": {
              "required": [
                "candidate_commit",
                "stable_commit",
                "acceptance_evidence",
                "acceptance_evidence_sha256",
                "integration_proof"
              ]
            }
          }
        ]
      }
    }
  }
}
