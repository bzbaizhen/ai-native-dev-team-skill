{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bzbaizhen/ai-native-dev-team-skill/p3-sigstore-github-proof.schema.json",
  "title": "P3 Sigstore and GitHub TSA retained proof inventory",
  "description": "Strict local inventory for the frozen Sigstore/Rekor/GitHub RFC 3161 profile. Inventory fields are never verification results.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "submitted_envelope_sha256",
    "cosign_bundle",
    "cosign_public_key",
    "sigstore_trusted_root",
    "raw_signature",
    "github_timestamp_token",
    "github_leaf",
    "github_intermediate",
    "github_root",
    "verification_policy_id",
    "tool_inventory",
    "acquired_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "profile_id": {"const": "p3-sigstore-rekor-v1-sigstore-tsa-github-rfc3161-v1"},
    "submitted_envelope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cosign_bundle": {"$ref": "#/$defs/retained_file"},
    "cosign_public_key": {"$ref": "#/$defs/retained_file"},
    "sigstore_trusted_root": {"$ref": "#/$defs/retained_file"},
    "raw_signature": {"$ref": "#/$defs/retained_file"},
    "github_timestamp_token": {"$ref": "#/$defs/retained_file"},
    "github_leaf": {"$ref": "#/$defs/github_leaf"},
    "github_intermediate": {"$ref": "#/$defs/github_intermediate"},
    "github_root": {"$ref": "#/$defs/github_root"},
    "verification_policy_id": {"const": "p3-sigstore-rekor-v1-sigstore-tsa-github-rfc3161-v1"},
    "tool_inventory": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/tool"}
    },
    "acquired_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    }
  },
  "$defs": {
    "retained_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*//)(?!.*(?:^|/)\\.(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
        },
        "bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "github_leaf": {
      "allOf": [
        {"$ref": "#/$defs/retained_file"},
        {"properties": {"bytes": {"const": 790}, "sha256": {"const": "06940aa850c0912e7cf8d893b6bf509c719060f94eaa0a8b5deb5d7194e4bc77"}}}
      ]
    },
    "github_intermediate": {
      "allOf": [
        {"$ref": "#/$defs/retained_file"},
        {"properties": {"bytes": {"const": 802}, "sha256": {"const": "ebfcb01e412d295adcfd67fe3e7546a1f01b033074da03abdde0de9e99c96eac"}}}
      ]
    },
    "github_root": {
      "allOf": [
        {"$ref": "#/$defs/retained_file"},
        {"properties": {"bytes": {"const": 741}, "sha256": {"const": "6d6734c76d4280033315c30f63d20b7a8d5d4dd6d77c7446b08c93443beec26e"}}}
      ]
    },    "tool": {
      "oneOf": [
        {"$ref": "#/$defs/tool_cosign"},
        {"$ref": "#/$defs/tool_sigstore_root"},
        {"$ref": "#/$defs/tool_timestamp_cli"},
        {"$ref": "#/$defs/tool_openssl"},
        {"$ref": "#/$defs/tool_openssl_config"}
      ]
    },
    "tool_cosign": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "bytes", "sha256"],
      "properties": {"name": {"const": "cosign"}, "version": {"const": "v3.1.3"}, "bytes": {"const": 198819314}, "sha256": {"const": "9fe59be0eca1271873ce019061335eb1ac419b7059202e797828467ddabe33be"}}
    },
    "tool_sigstore_root": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "bytes", "sha256"],
      "properties": {"name": {"const": "sigstore-trusted-root"}, "version": {"const": "0.1"}, "bytes": {"const": 5747}, "sha256": {"const": "844a1c6de3986c9f02070266b25e0d1a2fa99ceccc89f6b9ad90aae47b62a16e"}}
    },
    "tool_timestamp_cli": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "bytes", "sha256"],
      "properties": {"name": {"const": "timestamp-cli"}, "version": {"const": "v2.1.3"}, "bytes": {"const": 22052352}, "sha256": {"const": "ef4bbf7715445f0c26a0fcdcd89162afab7d8dea64e5a8091ea3a1f804f22bd2"}}
    },
    "tool_openssl": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "bytes", "sha256"],
      "properties": {"name": {"const": "openssl"}, "version": {"const": "3.5.6"}, "bytes": {"const": 1005028}, "sha256": {"const": "063e62dcc027fc5dbb1343de631f02a9291f8b1df0b4e37012e49a03d525aad4"}}
    },
    "tool_openssl_config": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "bytes", "sha256"],
      "properties": {"name": {"const": "openssl-config"}, "version": {"const": "3.5.6"}, "bytes": {"const": 12411}, "sha256": {"const": "e4c87d84d4650c39a0163544a4107842b2ca42487cb61ba570b03b011275d6c3"}}
    }
  }
}
