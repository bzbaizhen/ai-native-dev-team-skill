{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bzbaizhen/ai-native-dev-team-skill/p2-manifest-alignment.schema.json",
  "title": "P2 Manifest alignment index",
  "description": "Local-only one-to-one mapping from trial task IDs to private ready/outcome bindings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_commit", "tasks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "candidate_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "ready_binding_sequence", "outcome_binding_sequence"],
        "properties": {
          "task_id": {"type": "string", "pattern": "^[!-~]+$"},
          "ready_binding_sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
          "outcome_binding_sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
        }
      }
    }
  }
}
