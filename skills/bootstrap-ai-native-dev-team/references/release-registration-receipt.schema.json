{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bzbaizhen/ai-native-dev-team-skill/release-registration-receipt.schema.json",
  "title": "Anchored V2 task-ready registration receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_type",
    "registration_sequence",
    "source_id",
    "project_evidence_id",
    "task_id",
    "registered_at",
    "skill_candidate_commit",
    "request_evidence",
    "request_evidence_sha256",
    "complexity",
    "risk",
    "topology",
    "release_trial_comparable",
    "v1_baseline_id",
    "v1_baseline_stratum",
    "genuine_request",
    "synthetic"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "receipt_type": {"const": "task_ready_registration"},
    "registration_sequence": {"type": "integer", "minimum": 1},
    "source_id": {"type": "string", "minLength": 1},
    "project_evidence_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "registered_at": {"type": "string", "format": "date-time"},
    "skill_candidate_commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "request_evidence": {"type": "string", "minLength": 1},
    "request_evidence_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "complexity": {"enum": ["C0", "C1", "C2", "C3"]},
    "risk": {"enum": ["R0", "R1", "R2", "R3"]},
    "topology": {
      "enum": ["no-delegation", "single-worker", "task-cell", "team-required"]
    },
    "release_trial_comparable": {"type": "boolean"},
    "v1_baseline_id": {"type": ["string", "null"], "minLength": 1},
    "v1_baseline_stratum": {"type": ["string", "null"], "minLength": 1},
    "genuine_request": {"type": "boolean"},
    "synthetic": {"type": "boolean"},
    "exclusion_reason": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {
        "properties": {"release_trial_comparable": {"const": true}},
        "required": ["release_trial_comparable"]
      },
      "then": {
        "required": ["v1_baseline_id"],
        "properties": {
          "v1_baseline_id": {"type": "string", "minLength": 1},
          "v1_baseline_stratum": {
            "type": "string",
            "pattern": "^C[0-3]\\|R[0-3]\\|(no-delegation|single-worker|task-cell|team-required)$"
          }
        }
      },
      "else": {
        "required": ["exclusion_reason"],
        "properties": {
          "v1_baseline_id": {"type": "null"},
          "v1_baseline_stratum": {"type": "null"}
        }
      }
    }
  ]
}
