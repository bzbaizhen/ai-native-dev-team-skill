{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bzbaizhen/ai-native-dev-team-skill/p2-public-anchor-manifest.schema.json",
  "title": "P2 public anchor manifest",
  "description": "Local-only exact public ref and one-envelope-per-Commit mapping.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "public_ref", "freeze_commit", "head_commit", "receipts"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "public_ref": {"type": "string", "pattern": "^refs/(?:heads|tags)/[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "freeze_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "commit", "path", "envelope_sha256"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "path": {"type": "string", "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*\\.json$"},
          "envelope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
