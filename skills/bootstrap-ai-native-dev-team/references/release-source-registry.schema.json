{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bzbaizhen/ai-native-dev-team-skill/release-source-registry.schema.json",
  "title": "Frozen V2 prospective source registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_commit",
    "candidate_frozen_at",
    "required_comparable_tasks",
    "sources"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "candidate_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "candidate_frozen_at": {"type": "string", "format": "date-time"},
    "required_comparable_tasks": {"type": "integer", "minimum": 5},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "project_alias",
          "project_evidence_id",
          "project_repo",
          "stable_branch",
          "ledger",
          "ledger_prefix_bytes",
          "ledger_prefix_sha256"
        ],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "project_alias": {"type": "string", "minLength": 1},
          "project_evidence_id": {"type": "string", "minLength": 1},
          "project_repo": {"type": "string", "minLength": 1},
          "stable_branch": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
          },
          "ledger": {"type": "string", "minLength": 1},
          "ledger_prefix_bytes": {"type": "integer", "minimum": 0},
          "ledger_prefix_sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        }
      }
    }
  }
}
